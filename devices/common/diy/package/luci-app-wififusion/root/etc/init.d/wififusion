#!/bin/sh /etc/rc.common
# WiFi Fusion：将 2.4G/5G 合并为同一 SSID 并开启 802.11k/v 漫游
# 可选集成 usteer：AP 主动 band steering（信号阈值引导 + 弱信号剔除）
START=95
STOP=10

SECTION="config"

ensure_usteer_config() {
	[ -f /etc/config/usteer ] || cat > /etc/config/usteer <<'EOF'
config usteer
	option network 'lan'
	option syslog '1'
	option local_mode '0'
	option debug_level '2'
	option band_steering_interval '30000'
	option band_steering_min_snr '-60'
	option min_snr '-75'
	option min_snr_kick_delay '5000'
	option steer_reject_timeout '60000'
EOF
}

apply_usteer() {
	local uenabled interval minsnr kicksnr
	config_get uenabled "$SECTION" usteer_enabled 0
	config_get interval "$SECTION" steer_interval 30000
	config_get minsnr "$SECTION" steer_min_signal -60
	config_get kicksnr "$SECTION" kick_min_signal -75

	ensure_usteer_config
	[ -n "$(uci -q show usteer 2>/dev/null)" ] || return 0
	if [ "$uenabled" = "1" ]; then
		uci set usteer.@usteer[0].band_steering_interval="$interval"
		uci set usteer.@usteer[0].band_steering_min_snr="$minsnr"
		uci set usteer.@usteer[0].min_snr="$kicksnr"
		uci set usteer.@usteer[0].min_snr_kick_delay='5000'
		uci set usteer.@usteer[0].steer_reject_timeout='60000'
		uci commit usteer
		/etc/init.d/usteer enable >/dev/null 2>&1
		/etc/init.d/usteer restart >/dev/null 2>&1
		logger -t wififusion "usteer 主动漫游已启用：间隔=${interval}ms 上行阈值=${minsnr}dBm 剔除阈值=${kicksnr}dBm"
	else
		uci set usteer.@usteer[0].band_steering_interval='0'
		uci commit usteer
		/etc/init.d/usteer stop >/dev/null 2>&1
		/etc/init.d/usteer disable >/dev/null 2>&1
		logger -t wififusion "usteer 主动漫游已关闭"
	fi
}

apply_fusion() {
	local enabled ssid key encryption
	config_get enabled "$SECTION" enabled 0
	[ "$enabled" = "1" ] || { logger -t wififusion "未启用，跳过"; return 0; }
	config_get ssid "$SECTION" ssid ""
	config_get key "$SECTION" key ""
	config_get encryption "$SECTION" encryption ""

	[ -z "$ssid" ] && { logger -t wififusion "未设置 SSID，跳过"; return 1; }

	local changed=0 iface dev
	for iface in $(uci -q show wireless | sed -n "s/^\(.*\)=wifi-iface$/\1/p" | cut -d. -f2); do
		[ "$(uci -q get wireless.$iface.ssid)" != "$ssid" ] && {
			uci set wireless.$iface.ssid="$ssid"; changed=1
		}
		[ -n "$key" ] && { uci set wireless.$iface.key="$key"; changed=1; }
		[ -n "$encryption" ] && { uci set wireless.$iface.encryption="$encryption"; changed=1; }
		# 802.11k/v 频段漫游（band steering）核心开关
		for opt in ieee80211k:1 ieee80211v:1 bss_transition:1 wnm_sleep_mode:1 time_advertisement:2; do
			o=${opt%%:*}; v=${opt##*:}
			uci set wireless.$iface.$o="$v"
		done
		uci set wireless.$iface.time_zone="GMT0"
		changed=1
		# 确保射频未被禁用
		dev=$(uci -q get wireless.$iface.device)
		[ -n "$dev" ] && uci -q set wireless.$dev.disabled=0
	done

	uci commit wireless
	if [ "$changed" = "1" ]; then
		logger -t wififusion "双频合一已应用：SSID=$ssid，802.11k/v 漫游开启"
		wifi reload
	fi
	apply_usteer
}

start() {
	config_load wififusion
	apply_fusion
}

restart() { start; }
