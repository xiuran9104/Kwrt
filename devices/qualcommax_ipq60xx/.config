
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_ALL_PROFILES=n
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

CONFIG_KERNEL_CC_OPTIMIZE_FOR_SIZE=y

# OpenWrt.ai custom build selection for JDCloud AX6600.
CONFIG_PACKAGE_luci-app-accesscontrol-plus=y
CONFIG_PACKAGE_luci-app-qbittorrent=y
CONFIG_PACKAGE_luci-app-shunt=y
CONFIG_PACKAGE_automount=y
CONFIG_PACKAGE_luci-app-broadbandacc=y
CONFIG_PACKAGE_luci-app-wrtbwmon=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall2=n

# Use fw3/iptables instead of fw4/nftables.
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_firewall4=n
CONFIG_PACKAGE_nftables=n
CONFIG_PACKAGE_nftables-json=n
CONFIG_PACKAGE_nftables-nojson=n
CONFIG_PACKAGE_kmod-nft-offload=n
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_iptables-zz-legacy=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-extra=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y





# --- 本地定制（亚瑟专用） ---
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-app-vantage=y
CONFIG_PACKAGE_luci-app-quickstart=y
# 注意：不可选 docker 系列 —— 亚瑟 rootfs 分区仅 ~60MB，超限 U-Boot 无法写入
CONFIG_PACKAGE_luci-app-wififusion=y
# APK 打包模式必须带 apk 工具，否则设备上无包管理器（luci-app-package-manager 页空白）
CONFIG_PACKAGE_apk-mbedtls=y
